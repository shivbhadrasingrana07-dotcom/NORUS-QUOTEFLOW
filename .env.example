# GEMINI_API_KEY: Required for Gemini AI supplier quotation extraction.
# Configure this via Secrets in AI Studio or environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application (used for CORS allowlist and email links).
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Optional comma-separated extra allowed origins for CORS.
ALLOWED_ORIGINS=""

# SESSION_SECRET: Required in production (>= 32 random chars) for HMAC-signing URLs & tokens.
# Generate via: openssl rand -hex 32
SESSION_SECRET=""
COOKIE_SAMESITE=""
CSP_MODE=""
TRUST_PROXY_HOPS="1"

# Cloud SQL / PostgreSQL Connection (Object Method - do not use DATABASE_URL)
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
SQL_SSL="false"
SQL_SSL_CA=""
SQL_SSL_ALLOW_SELF_SIGNED="false"

# Private Object Storage (s3 | local)
# In production, configure S3/R2/MinIO credentials and set STORAGE_PROVIDER=s3.
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Transactional Email (Resend; falls back to DevOutboxEmailProvider in dev/test)
RESEND_API_KEY=""
EMAIL_FROM="NORUS QUOTEFLOW <noreply@example.com>"

# Operational Maintenance & Monitoring
MAINTENANCE_INTERVAL_MINUTES="360"
ERROR_WEBHOOK_URL=""

# Temporary No-Login Demo Mode (Task 006 / Hardened Task 007)
# - Development / Preview (NODE_ENV != "production"): leaving DEMO_MODE unset or "true" enables the isolated in-memory sample workspace (/api/demo-workspace).
# - Set DEMO_MODE="false" to restore Firebase Google Sign-In + Email/Password authentication and multi-tenant PostgreSQL workspaces.
# - Production (NODE_ENV="production"): Demo mode is ALWAYS OFF by default; setting DEMO_MODE="true" in production fails server startup safely.
DEMO_MODE=""

# Organization Plan Policy Default for Newly Created Workspaces (Task 017)
# - Valid values: starter (default) | professional | business | legacy
# - Pre-existing migrated organizations retain plan_tier="legacy" (non-blocking) unless explicitly updated in DB.
DEFAULT_NEW_ORG_PLAN="starter"

